#<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Flores animadas</title>

<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #1d756c;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}
</style>
</head>

<body>

<canvas id="flores"></canvas>

<script>

const canvas = document.getElementById("flores");
const ctx = canvas.getContext("2d");

let ancho;
let alto;

function ajustarCanvas() {

    ancho = canvas.width = window.innerWidth;
    alto = canvas.height = window.innerHeight;

}

ajustarCanvas();

window.addEventListener("resize", ajustarCanvas);


/* =====================================
   FLORES
===================================== */

const flores = [

    {
        x: 0.50,
        y: 0.42,
        tamaño: 1.15,
        retraso: 0
    },

    {
        x: 0.42,
        y: 0.50,
        tamaño: 0.95,
        retraso: 400
    },

    {
        x: 0.58,
        y: 0.48,
        tamaño: 1.00,
        retraso: 700
    },

    {
        x: 0.35,
        y: 0.58,
        tamaño: 0.85,
        retraso: 1000
    },

    {
        x: 0.65,
        y: 0.57,
        tamaño: 0.90,
        retraso: 1300
    },

    {
        x: 0.50,
        y: 0.32,
        tamaño: 0.90,
        retraso: 1600
    }

];


/* =====================================
   DIBUJAR UNA FLOR
===================================== */

function dibujarFlor(flor, tiempo) {

    const x = flor.x * ancho;
    const y = flor.y * alto;

    /*
       Animación de crecimiento
    */

    let crecimiento =
        (tiempo - flor.retraso) / 1800;

    if (crecimiento < 0)
        crecimiento = 0;

    if (crecimiento > 1)
        crecimiento = 1;


    /*
       Suavizado
    */

    crecimiento =
        1 - Math.pow(1 - crecimiento, 3);


    const escala =
        crecimiento * flor.tamaño;


    /*
       Movimiento de la flor
    */

    const movimiento =
        Math.sin(tiempo * 0.0015 + flor.x * 10)
        * 7;


    /*
       Movimiento de inclinación
    */

    const inclinacion =
        Math.sin(tiempo * 0.0012 + flor.y * 8)
        * 0.08;


    ctx.save();


    /*
       Posición
    */

    ctx.translate(
        x + movimiento,
        y
    );


    ctx.rotate(inclinacion);


    /*
       TALLO
    */

    ctx.strokeStyle = "#318b39";

    ctx.lineWidth = 6 * escala;

    ctx.lineCap = "round";

    ctx.beginPath();

    ctx.moveTo(0, 0);

    ctx.quadraticCurveTo(
        -8 * escala,
        70 * escala,
        5 * escala,
        180 * escala
    );

    ctx.stroke();


    /*
       HOJA IZQUIERDA
    */

    ctx.fillStyle = "#39983f";

    ctx.beginPath();

    ctx.ellipse(
        -20 * escala,
        105 * escala,
        35 * escala,
        12 * escala,
        -0.5,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /*
       HOJA DERECHA
    */

    ctx.beginPath();

    ctx.ellipse(
        20 * escala,
        140 * escala,
        35 * escala,
        12 * escala,
        0.5,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /*
       PÉTALOS
    */

    const cantidadPetalos = 18;

    for (
        let i = 0;
        i < cantidadPetalos;
        i++
    ) {

        const angulo =
            (Math.PI * 2 / cantidadPetalos) * i;

        ctx.save();

        ctx.rotate(angulo);


        /*
           Pétalo
        */

        ctx.fillStyle = "#FFD800";

        ctx.beginPath();

        ctx.ellipse(
            0,
            -42 * escala,
            17 * escala,
            34 * escala,
            0,
            0,
            Math.PI * 2
        );

        ctx.fill();

        ctx.restore();

    }


    /*
       CENTRO DE LA FLOR
    */

    ctx.fillStyle = "#5a3508";

    ctx.beginPath();

    ctx.arc(
        0,
        0,
        28 * escala,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /*
       Semillas del centro
    */

    ctx.fillStyle = "#8b5a12";

    for (
        let i = 0;
        i < 35;
        i++
    ) {

        const angulo =
            Math.random() * Math.PI * 2;

        const radio =
            Math.random() * 21 * escala;

        ctx.beginPath();

        ctx.arc(
            Math.cos(angulo) * radio,
            Math.sin(angulo) * radio,
            2 * escala,
            0,
            Math.PI * 2
        );

        ctx.fill();

    }


    ctx.restore();

}


/* =====================================
   ANIMACIÓN
===================================== */

const inicio =
    performance.now();


function animar(tiempo) {

    /*
       Fondo
    */

    const degradado =
        ctx.createLinearGradient(
            0,
            0,
            0,
            alto
        );

    degradado.addColorStop(
        0,
        "#267e74"
    );

    degradado.addColorStop(
        1,
        "#155f59"
    );

    ctx.fillStyle =
        degradado;

    ctx.fillRect(
        0,
        0,
        ancho,
        alto
    );


    /*
       Dibujar flores
    */

    flores.forEach(
        flor => {

            dibujarFlor(
                flor,
                tiempo - inicio
            );

        }
    );


    /*
       Siguiente cuadro
    */

    requestAnimationFrame(animar);

}


requestAnimationFrame(animar);

</script>

</body>
